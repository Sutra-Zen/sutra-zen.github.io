  "scenes": [
    {
      "id": "S01",
      "title": "隨法行與隨信行",
      "startSec": 0.2,
      "endSec": 71,
      "originalFilename": "IMG_0393.jpeg",
      "asset": "assets/IMG_0393.jpeg",
      "topSubtitle": {
        "anchor": "top-left",
        "color": "#111111",
        "cues": [
          {
            "startSec": 1,
            "text": "在修行的這條小河畔，每個人的起點都不太一樣喔！"
          },
          {
            "startSec": 7,
            "text": "你看，這隻戴著學士帽、穿著學士袍的「隨法行」貓咪，"
          },
          {
            "startSec": 11,
            "text": "他擁有著敏銳的智慧，凡事都喜歡拿著放大鏡專注地觀察、思惟，"
          },
          {
            "startSec": 19,
            "text": "看清了書本中漂浮的邏輯，非得把生命的無常徹底想明白了，"
          },
          {
            "startSec": 23,
            "text": "才肯邁出安心的下一步。"
          },
          {
            "startSec": 27,
            "text": "而另一邊，是這隻雙手合十、眼神澄澈的「隨信行」小兔，"
          },
          {
            "startSec": 33,
            "text": "雖然他不像貓咪那樣理性思辨，但只要聽聞了清淨的佛法，"
          },
          {
            "startSec": 39,
            "text": "心中就會自然生起無比純淨的信任與安定，身邊就自然盛開出了蓮花。"
          },
          {
            "startSec": 45,
            "text": "你看，當這兩股不同的力量在主流匯合，他們都已經超越了凡夫的境界！"
          },
          {
            "startSec": 53,
            "text": "不管是貓咪那種理性的觀察智慧，還是小兔那份感性的信任信心，"
          },
          {
            "startSec": 59,
            "text": "只要目標一致，順著河流主流而下，他們都已經成為了「須陀洹」，"
          },
          {
            "startSec": 65,
            "text": "中間永不死去，必定能走向彼岸那光芒溫暖的「涅槃」寂靜！"
          }
        ]
      },
      "artOverlay": [],
      "bakedText": "上左貓咪與「隨法行」、下左兔子與「隨信行」、中央「須陀洹」、右側「涅槃」及各牌英文，都是原圖自帶字。",
      "safeArea": "保留合流線和四個標示，特別留出左下牌。",
      "bottomScripture": {
        "cues": [
          {
            "startSec": 1,
            "sourceId": "SA61",
            "text": "若於此法增上智慧思惟、觀察、忍，是名隨法行。超昇離生、越凡夫地，未得須陀洹果，中間不死，必得須陀洹果。",
            "kind": "影片畫面錄文或摘要"
          }
        ]
      }
    },
    {
      "id": "S02",
      "title": "四入流分",
      "startSec": 71,
      "endSec": 113,
      "originalFilename": "IMG_0395.jpeg",
      "asset": "assets/IMG_0395.jpeg",
      "topSubtitle": {
        "anchor": "top-left",
        "color": "#111111",
        "cues": [
          {
            "startSec": 71,
            "text": "那麼，我們該怎麼駕駛生命的小船，"
          },
          {
            "startSec": 75,
            "text": "正式駛入這條名為「八正道」的清淨大河呢？"
          },
          {
            "startSec": 79,
            "text": "佛陀給了一份稱為「四入流分」的航行指南："
          },
          {
            "startSec": 83,
            "text": "首先，是找到能為你提燈引路的導航員「親近善知識」；"
          },
          {
            "startSec": 89,
            "text": "接著，專心讀懂他給你的航海圖，也就是「聽聞正法」。"
          },
          {
            "startSec": 95,
            "text": "有了外部的指引後，我們必須轉向內心，"
          },
          {
            "startSec": 99,
            "text": "用正確的邏輯去核對指南針，也就是「內正思惟」；"
          },
          {
            "startSec": 103,
            "text": "最後，也是最重要的一步，就是親自握住船槳，"
          },
          {
            "startSec": 109,
            "text": "在生活中確實地划動它，也就是「法次法向」。"
          }
        ]
      },
      "artOverlay": [
        {
          "text": "四入流分",
          "xPct": 43,
          "yPct": 19,
          "maxWidthPct": 28,
          "fontSizePctOfImageWidth": 6,
          "anchor": "center",
          "align": "center",
          "color": "#ffffff",
          "safeArea": "上方林際與亮天空之間，位於左側善友木牌右上。",
          "startSec": 71,
          "endSec": 113,
          "portraitOverride": "維持圖框百分比與單行。上緣字幕和按鍵移到圖外。"
        }
      ],
      "bakedText": "四張木牌「親近善友」「聽聞正法」「內正思惟」「法次法向」已在畫中。",
      "safeArea": "保留貓頭鷹、燈、指南針、船槳與四塊牌。",
      "bottomScripture": {
        "cues": [
          {
            "startSec": 71,
            "sourceId": "SA843",
            "text": "流者謂八聖道。入流分有四種，謂親近善男子、聽正法、內正思惟、法次法向。入流者成就四法，謂於佛、法、僧不壞淨，聖戒成就。",
            "kind": "影片畫面錄文或摘要"
          }
        ]
      }
    },
    {
      "id": "S03",
      "title": "轉輪王與聖弟子",
      "startSec": 113,
      "endSec": 175,
      "originalFilename": "IMG_0396.jpeg",
      "asset": "assets/IMG_0396.jpeg",
      "topSubtitle": {
        "anchor": "top-left",
        "color": "#111111",
        "cues": [
          {
            "startSec": 113,
            "text": "想像一下，如果有人擁有全世界的財富與權力，"
          },
          {
            "startSec": 119,
            "text": "甚至死後還能升上天堂，享受無盡的派對。"
          },
          {
            "startSec": 123,
            "text": "這樣的人，是不是最安全的呢？佛陀搖搖頭說：「不是的。」"
          },
          {
            "startSec": 129,
            "text": "就像左邊這位擁有統治權的轉輪聖王，"
          },
          {
            "startSec": 133,
            "text": "即使他擁有一切，但因為心裡沒有真正的依靠，他的王座底下，"
          },
          {
            "startSec": 139,
            "text": "依然藏著通往痛苦深淵「地獄界、畜生界、餓鬼界」的陷阱。"
          },
          {
            "startSec": 145,
            "text": "但你看看右邊這位聖弟子，他或許只能吃著簡單的粗茶淡飯，"
          },
          {
            "startSec": 151,
            "text": "披著縫補過的舊斗篷；但他的內心，卻擁有了四把無堅不摧的保護傘！"
          },
          {
            "startSec": 159,
            "text": "這四股力量化為金色的防護罩，"
          },
          {
            "startSec": 163,
            "text": "讓他徹底斬斷了掉入痛苦深淵的可能，獲得了真正的自由。"
          },
          {
            "startSec": 169,
            "text": "究竟是哪四股神奇的力量，竟然比全世界的財富與權力還要強大呢？"
          }
        ]
      },
      "artOverlay": [],
      "bakedText": "無。",
      "safeArea": "左邊王座及下方漩渦、右邊兔子與金色光罩都要入畫。",
      "bottomScripture": {
        "cues": [
