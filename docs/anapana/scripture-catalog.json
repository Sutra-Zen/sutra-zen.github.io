{
  "Q01": {
    "id": "Q01",
    "source": "雜阿含經第802經",
    "text": "若比丘修習安那般那念，多修習者，得身心止息，有覺有觀寂滅，純一明分想修習滿足。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q02": {
    "id": "Q02",
    "source": "雜阿含經第801經",
    "text": "住於淨戒、波羅提木叉律儀，威儀行處具足，於微細罪能生怖畏，受持學戒。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q03": {
    "id": "Q03",
    "source": "雜阿含經第801經",
    "text": "少欲、少事、少務，是名二法多所饒益修習安那般那念。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q04": {
    "id": "Q04",
    "source": "雜阿含經第801經",
    "text": "飲食知量，多少得中，不為飲食起求欲想，精勤思惟，是名三法多所饒益修安那般那念。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q05": {
    "id": "Q05",
    "source": "雜阿含經第801經",
    "text": "初夜、後夜不著睡眠，精勤思惟，是名四法多所饒益修安那般那念。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q06": {
    "id": "Q06",
    "source": "雜阿含經第803經",
    "text": "端身正坐，繫念面前，斷世貪愛，離欲清淨，瞋恚、睡眠、掉悔、疑斷，度諸疑惑，於諸善法心得決定，遠離五蓋煩惱於心，令慧力羸，為障礙分，不趣涅槃。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q07": {
    "id": "Q07",
    "source": "雜阿含經第803經",
    "text": "念於內息，繫念善學，念於外息，繫念善學。息長、息短。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q08": {
    "id": "Q08",
    "source": "雜阿含經第803經",
    "text": "覺知一切身入息，於一切身入息善學；覺知一切身出息，於一切身出息善學。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q09": {
    "id": "Q09",
    "source": "雜阿含經第803經",
    "text": "覺知一切身行息入息，於一切身行息入息善學；覺知一切身行息出息，於一切身行息出息善學。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q10": {
    "id": "Q10",
    "source": "中部118經・入出息念經（影片譯文）",
    "text": "我說這樣是在諸身中的一種，即：吸氣與呼氣。比丘們！因此，在這裡，在那時，比丘在身上隨看身地住：熱心的、正知的、有念的，調伏世間中的貪婪、憂惱。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q11": {
    "id": "Q11",
    "source": "雜阿含經第803經",
    "text": "覺知喜入息，於覺知喜入息善學；覺知喜出息，於覺知喜出息善學。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q12": {
    "id": "Q12",
    "source": "雜阿含經第803經",
    "text": "覺知樂入息，於覺知樂入息善學；覺知樂出息，於覺知樂出息善學。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q13": {
    "id": "Q13",
    "source": "雜阿含經第803經",
    "text": "覺知心行入息，於覺知心行入息善學；覺知心行出息，於覺知心行出息善學。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q14": {
    "id": "Q14",
    "source": "雜阿含經第803經",
    "text": "覺知心行息入息，於覺知心行息入息善學；覺知心行息出息，於覺知心行息出息善學。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q15": {
    "id": "Q15",
    "source": "中部118經・入出息念經（影片譯文）",
    "text": "這樣是在諸受中受的一種，即：吸氣與呼氣的好好作意。比丘們！因此，在這裡，在那時，比丘在諸受上隨看受地住：熱心的、正知的、有念的，調伏世間中的貪婪、憂惱。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q16": {
    "id": "Q16",
    "source": "雜阿含經第803經",
    "text": "覺知心入息，於覺知心入息善學；覺知心出息，於覺知心出息善學。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q17": {
    "id": "Q17",
    "source": "雜阿含經第803經",
    "text": "覺知心悅入息，於覺知心悅入息善學；覺知心悅出息，於覺知心悅出息善學。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q18": {
    "id": "Q18",
    "source": "雜阿含經第803經",
    "text": "覺知心定入息，於覺知心定入息善學；覺知心定出息，於覺知心定出息善學。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q19": {
    "id": "Q19",
    "source": "雜阿含經第803經",
    "text": "覺知心解脫入息，於覺知心解脫入息善學；覺知心解脫出息，於覺知心解脫出息善學。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q20": {
    "id": "Q20",
    "source": "中部118經・入出息念經（影片譯文）",
    "text": "比丘們！我不說念已忘失、不正知者有入出息念。比丘們！因此，在這裡，在那時，比丘在心上隨看心地住：熱心的、正知的、有念的，調伏世間中的貪婪、憂惱。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q21": {
    "id": "Q21",
    "source": "雜阿含經第803經",
    "text": "觀察無常入息，於觀察無常入息善學；觀察無常出息，於觀察無常出息善學。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q22": {
    "id": "Q22",
    "source": "雜阿含經第803經",
    "text": "觀察斷入息，於觀察斷入息善學；觀察斷出息，於觀察斷出息善學。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q23": {
    "id": "Q23",
    "source": "雜阿含經第803經",
    "text": "觀察無欲入息，於觀察無欲入息善學；觀察無欲出息，於觀察無欲出息善學。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q24": {
    "id": "Q24",
    "source": "雜阿含經第803經",
    "text": "觀察滅入息，於觀察滅入息善學；觀察滅出息，於觀察滅出息善學。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q25": {
    "id": "Q25",
    "source": "中部118經・入出息念經（影片譯文）",
    "text": "凡是能以智慧照見那裡貪憂已被斷除的人，他就是一個善於保持平靜觀照的人。比丘們！因此，在那個當下，比丘就是在法上隨觀法而住：熱心的、正知的、有念的，調伏了世間的貪婪與憂愁。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q26": {
    "id": "Q26",
    "source": "中部118經・入出息念經（影片譯文）",
    "text": "因此，在那個當下，比丘就是在法上隨觀法而住：熱心的、正知的、有念的，調伏了世間的貪婪與憂愁。比丘們！入出息念這麼已修習、這麼已多作使四念住完成。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q27": {
    "id": "Q27",
    "source": "雜阿含經第464經",
    "text": "修習於止，終成於觀，修習觀已，亦成於止。謂聖弟子止、觀俱修，得諸解脫界。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q28": {
    "id": "Q28",
    "source": "雜阿含經第560經",
    "text": "若比丘、比丘尼坐，作如是住心：善住心、局住心、調伏心、止觀一心、等受，分別於法、量度，修習多修習已，得斷諸使。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q29": {
    "id": "Q29",
    "source": "雜阿含經第560經",
    "text": "比丘、比丘尼正坐思惟，於法選擇、思量，住心：善住、局住、調伏、止觀一心、等受，如是正向多住，得離諸使。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q30": {
    "id": "Q30",
    "source": "雜阿含經第560經",
    "text": "比丘、比丘尼為掉亂所持，以調伏心坐，正坐住心：善住心、局住心、調伏、止觀一心、等受住。如是正向多住已，則斷諸使。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q31": {
    "id": "Q31",
    "source": "雜阿含經第560經",
    "text": "比丘、比丘尼止觀和合俱行，作如是正向多住，則斷諸使。",
    "sourceType": "canonical",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q32": {
    "id": "Q32",
    "source": "修次中編、下編（影片摘引；論師）",
    "text": "於安樂具身具八法。足者，謂全跏趺，如毘盧遮那佛坐，或半跏趺。",
    "sourceType": "commentarial",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q33": {
    "id": "Q33",
    "source": "修次中編、下編（影片摘引；論師）",
    "text": "身者，謂非過後仰，莫太前屈，端身內念。",
    "sourceType": "commentarial",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q34": {
    "id": "Q34",
    "source": "修次中編、下編（影片摘引；論師）",
    "text": "肩者，謂平齊而住。",
    "sourceType": "commentarial",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q35": {
    "id": "Q35",
    "source": "修次中編、下編（影片摘引；論師）",
    "text": "頭者，莫揚，莫低，莫歪一方，且鼻至臍正直而住。",
    "sourceType": "commentarial",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q36": {
    "id": "Q36",
    "source": "修次中編、下編（影片摘引；論師）",
    "text": "眼者，謂不應太開，亦非太閉，垂注鼻端。",
    "sourceType": "commentarial",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q37": {
    "id": "Q37",
    "source": "修次中編、下編（影片摘引；論師）",
    "text": "齒與唇者，隨自然住。舌者，令抵上齒。",
    "sourceType": "commentarial",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q38": {
    "id": "Q38",
    "source": "修次中編、下編（影片摘引；論師）",
    "text": "息者，內外出入莫令有聲、粗猛急滑，必使出入無所知覺，全無功用徐徐而轉。",
    "sourceType": "commentarial",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q39": {
    "id": "Q39",
    "source": "安般守意經（影片摘引；出處截圖註金剛寺版）",
    "text": "數為何等？入息出息數十息，無得過十息，無得減十息。入息至竟投一、出息至竟投一。若投二息誤，更從一投起；若至九投意誤，更從一數起，令與數十息入息出息數，是名為數。何用是數？但從是斷家中念。",
    "sourceType": "commentarial",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q40": {
    "id": "Q40",
    "source": "安般守意經（影片摘引；出處截圖註金剛寺版）",
    "text": "隨為何等？入息至竟，當隨，莫投一。出息至竟，當隨，莫投一，是名為隨。何用是隨？但從是斷外念。",
    "sourceType": "commentarial",
    "verification": "transcribed_from_video_not_externally_collated"
  },
  "Q41": {
    "id": "Q41",
    "source": "安般守意經（影片摘引；出處截圖註金剛寺版）",
    "text": "止為何等？入息至竟，還止鼻頭，莫隨。出息至竟，著鼻頭，莫隨。是為止，何用是止？但欲從是止念。",
    "sourceType": "commentarial",
    "verification": "transcribed_from_video_not_externally_collated"
  }
}
