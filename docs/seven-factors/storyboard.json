  },
  {
    "id": "S05",
    "title": "擇法",
    "startSeconds": 65.0,
    "endSeconds": 79.0,
    "asset": "images/05.png",
    "cues": [
      {
        "id": "P012",
        "startTime": "1:05",
        "startSeconds": 65.0,
        "text": "第二個，是「擇法覺支」。",
        "endSeconds": 69.0,
        "quoteIds": [
          "Q05"
        ]
      },
      {
        "id": "P013",
        "startTime": "1:09",
        "startSeconds": 69.0,
        "text": "學會分辨善法與不善法，知道什麼值得培養，什麼應該遠離。",
        "endSeconds": 75.0,
        "quoteIds": [
          "Q05"
        ]
      },
      {
        "id": "P014",
        "startTime": "1:15",
        "startSeconds": 75.0,
        "text": "就像照顧花園，要認得幼苗，也要認得雜草。",
        "endSeconds": 79.0,
        "quoteIds": [
          "Q05"
        ]
      }
    ],
    "scriptureCues": [
      {
        "startSeconds": 65.0,
        "quoteId": "Q05"
      }
    ],
    "artOverlay": [
      {
        "text": "擇法",
        "x": 70,
        "y": 53,
        "width": 24,
        "fontSizeCqw": 7.3163875598086126,
        "color": "#000000",
        "textAlign": "center",
        "anchor": "center",
        "heightPct": 13
      }
    ],
    "originalOverlaySpecification": "擇法 (70,53)"
  },
  {
    "id": "S06",
    "title": "精進",
    "startSeconds": 79.0,
    "endSeconds": 93.0,
    "asset": "images/06.png",
    "cues": [
      {
        "id": "P015",
        "startTime": "1:19",
        "startSeconds": 79.0,
        "text": "第三個，是「精進覺支」。分辨清楚後，還要付諸行動。",
        "endSeconds": 86.0,
        "quoteIds": [
          "Q06"
        ]
      },
      {
        "id": "P016",
        "startTime": "1:26",
        "startSeconds": 86.0,
        "text": "就像四正勤所教導的：避免、斷除不善法，讓善法生起，並持續增長。",
        "endSeconds": 93.0,
        "quoteIds": [
          "Q07"
        ]
      }
    ],
    "scriptureCues": [
      {
        "startSeconds": 79.0,
        "quoteId": "Q06"
      },
      {
        "startSeconds": 86.0,
        "quoteId": "Q07"
      }
    ],
    "artOverlay": [
      {
        "text": "精進",
        "x": 70,
        "y": 53,
        "width": 24,
        "fontSizeCqw": 7.3163875598086126,
        "color": "#000000",
        "textAlign": "center",
        "anchor": "center",
        "heightPct": 13
      }
    ],
    "originalOverlaySpecification": "精進 (70,53)"
  },
  {
    "id": "S07",
    "title": "喜",
    "startSeconds": 93.0,
    "endSeconds": 105.0,
    "asset": "images/07.png",
    "cues": [
      {
        "id": "P017",
        "startTime": "1:33",
        "startSeconds": 93.0,
        "text": "第四個，是「喜覺支」。當善法逐漸增長，心也生起清明的歡喜。",
        "endSeconds": 101.0,
        "quoteIds": [
          "Q08"
        ]
      },
      {
        "id": "P018",
        "startTime": "1:41",
        "startSeconds": 101.0,
        "text": "這份喜悅，來自修行，而不只是外在的享樂。",
        "endSeconds": 105.0,
        "quoteIds": [
          "Q08"
        ]
      }
    ],
    "scriptureCues": [
      {
        "startSeconds": 93.0,
        "quoteId": "Q08"
      }
    ],
    "artOverlay": [
      {
        "text": "喜",
        "x": 49,
        "y": 53,
        "width": 24,
        "fontSizeCqw": 7.3163875598086126,
        "color": "#000000",
        "textAlign": "center",
        "anchor": "center",
        "heightPct": 13
      }
    ],
    "originalOverlaySpecification": "喜 (49,53)"
  },
  {
    "id": "S08",
    "title": "輕安",
    "startSeconds": 105.0,
    "endSeconds": 118.0,
    "asset": "images/08.png",
    "cues": [
      {
        "id": "P019",
        "startTime": "1:45",
        "startSeconds": 105.0,
        "text": "第五個，是「輕安覺支」。歡喜之後，身與心漸漸平息，變得柔和、安穩。",
        "endSeconds": 114.0,
        "quoteIds": [
          "Q09"
        ]
      },
      {
        "id": "P020",
        "startTime": "1:54",
        "startSeconds": 114.0,
        "text": "這不是昏沉，而是清醒而舒適的寧靜。",
        "endSeconds": 118.0,
        "quoteIds": [
          "Q09"
        ]
      }
    ],
    "scriptureCues": [
      {
        "startSeconds": 105.0,
        "quoteId": "Q09"
      }
    ],
    "artOverlay": [
      {
        "text": "輕安",
        "x": 56,
        "y": 19,
        "width": 24,
        "fontSizeCqw": 7.3163875598086126,
        "color": "#000000",
        "textAlign": "center",
        "anchor": "center",
        "heightPct": 13
      }
    ],
    "originalOverlaySpecification": "輕安 (56,19)，位於臉部右上方天空。"
  },
  {
    "id": "S09",
    "title": "定",
    "startSeconds": 118.0,
    "endSeconds": 130.0,
    "asset": "images/09.png",
    "cues": [
      {
        "id": "P021",
        "startTime": "1:58",
        "startSeconds": 118.0,
        "text": "第六個，是「定覺支」。身心安穩後，心逐漸集中，不再四處散亂。",
        "endSeconds": 126.0,
        "quoteIds": [
          "Q10"
        ]
      },
      {
        "id": "P022",
        "startTime": "2:06",
        "startSeconds": 126.0,
        "text": "就像湖水平靜下來，心能穩穩地安住。",
        "endSeconds": 130.0,
        "quoteIds": [
          "Q10"
        ]
      }
    ],
    "scriptureCues": [
      {
        "startSeconds": 118.0,
        "quoteId": "Q10"
      }
    ],
    "artOverlay": [
      {
