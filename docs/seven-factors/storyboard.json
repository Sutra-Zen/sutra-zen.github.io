  {
    "id": "S12",
    "title": "七覺支總結",
    "startSeconds": 179.0,
    "endSeconds": 213.21,
    "asset": "images/12.jpeg",
    "cues": [
      {
        "id": "P031",
        "startTime": "2:59",
        "startSeconds": 179.0,
        "text": "所以，修習七覺支，不只是把七個名字記起來。",
        "endSeconds": 184.0,
        "quoteIds": [
          "Q16"
        ]
      },
      {
        "id": "P032",
        "startTime": "3:04",
        "startSeconds": 184.0,
        "text": "更要時時觀察，現在，哪些覺支已經生起？哪些還沒有？",
        "endSeconds": 191.0,
        "quoteIds": [
          "Q16"
        ]
      },
      {
        "id": "P033",
        "startTime": "3:11",
        "startSeconds": 191.0,
        "text": "還沒生起的，如何培養？已經生起的，又如何修習，直到圓滿？",
        "endSeconds": 198.0,
        "quoteIds": [
          "Q16"
        ]
      },
      {
        "id": "P034",
        "startTime": "3:18",
        "startSeconds": 198.0,
        "text": "原來，修行不是勉強把心壓得平靜，",
        "endSeconds": 201.0,
        "quoteIds": [
          "Q16"
        ]
      },
      {
        "id": "P035",
        "startTime": "3:21",
        "startSeconds": 201.0,
        "text": "而是先清楚看見自己的心，再依當下的需要，善巧地修習。",
        "endSeconds": 207.0,
        "quoteIds": [
          "Q16"
        ]
      },
      {
        "id": "P036",
        "startTime": "3:27",
        "startSeconds": 207.0,
        "text": "讓七覺支漸漸成熟，走向覺悟與解脫。",
        "endSeconds": 213.21,
        "quoteIds": [
          "Q16"
        ]
      }
    ],
    "scriptureCues": [
      {
        "startSeconds": 179.0,
        "quoteId": "Q16"
      }
    ],
    "artOverlay": [],
    "originalOverlaySpecification": "無。原圖已有中央「念」，以及擇法、精進、喜、輕安、定、捨六個標籤。"
  }
]
