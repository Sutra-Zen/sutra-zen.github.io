  {
    "id": "S04",
    "title": "念",
    "startSeconds": 43.0,
    "endSeconds": 65.0,
    "asset": "images/04.png",
    "cues": [
      {
        "id": "P008",
        "startTime": "0:43",
        "startSeconds": 43.0,
        "text": "佛陀教導七種幫助我們走向覺悟的修習，稱為「七覺支」。",
        "endSeconds": 49.0,
        "quoteIds": [
          "Q02"
        ]
      },
      {
        "id": "P009",
        "startTime": "0:49",
        "startSeconds": 49.0,
        "text": "第一個，是「念覺支」。",
        "endSeconds": 52.0,
        "quoteIds": [
          "Q03"
        ]
      },
      {
        "id": "P010",
        "startTime": "0:52",
        "startSeconds": 52.0,
        "text": "依四念處，清楚覺察身體、感受、心念，以及所經驗的種種現象。",
        "endSeconds": 59.0,
        "quoteIds": [
          "Q03"
        ]
      },
      {
        "id": "P011",
        "startTime": "0:59",
        "startSeconds": 59.0,
        "text": "就像小貓覺察自己的呼吸，也看見念頭如落葉般飄過，不必跟著它走。",
        "endSeconds": 65.0,
        "quoteIds": [
          "Q04"
        ]
      }
    ],
    "scriptureCues": [
      {
        "startSeconds": 43.0,
        "quoteId": "Q02"
      },
      {
        "startSeconds": 49.0,
        "quoteId": "Q03"
      },
      {
        "startSeconds": 59.0,
        "quoteId": "Q04"
      }
    ],
    "artOverlay": [
      {
        "text": "念",
        "x": 64,
        "y": 53,
        "width": 24,
        "fontSizeCqw": 7.3163875598086126,
