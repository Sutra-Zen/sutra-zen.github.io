    "originalOverlaySpecification": "定 (69,53)"
  },
  {
    "id": "S10",
    "title": "捨",
    "startSeconds": 130.0,
    "endSeconds": 142.0,
    "asset": "images/10.png",
    "cues": [
      {
        "id": "P023",
        "startTime": "2:10",
        "startSeconds": 130.0,
        "text": "第七個，是「捨覺支」。隨著定力成熟，貪著與憂惱逐漸止息。",
        "endSeconds": 137.0,
        "quoteIds": [
          "Q11"
        ]
      },
      {
        "id": "P024",
        "startTime": "2:17",
        "startSeconds": 137.0,
        "text": "心保持平等安穩，不再被喜歡與討厭牽著走。",
        "endSeconds": 142.0,
        "quoteIds": [
          "Q12"
        ]
      }
    ],
    "scriptureCues": [
      {
        "startSeconds": 130.0,
        "quoteId": "Q11"
      },
      {
        "startSeconds": 137.0,
        "quoteId": "Q12"
      }
    ],
