[
  {
    "id": "S01",
    "title": "浮動",
    "startSeconds": 0.0,
    "endSeconds": 15.0,
    "asset": "images/01.png",
    "cues": [
      {
        "id": "P001",
        "startTime": "0:00",
        "startSeconds": 0.0,
        "text": "想要專心修行的小貓，想讓自己的心安靜下來。",
        "endSeconds": 5.0,
        "quoteIds": []
      },
      {
        "id": "P002",
        "startTime": "0:05",
        "startSeconds": 5.0,
        "text": "可是，明明身體坐著不動，心卻一下想東、一下想西。",
        "endSeconds": 11.0,
        "quoteIds": []
      },
      {
        "id": "P003",
        "startTime": "0:11",
        "startSeconds": 11.0,
        "text": "為什麼越想安靜，心反而越靜不下來呢？",
        "endSeconds": 15.0,
        "quoteIds": []
      }
    ],
    "scriptureCues": [],
    "artOverlay": [],
    "originalOverlaySpecification": "無"
  },
  {
    "id": "S02",
    "title": "昏沉",
    "startSeconds": 15.0,
    "endSeconds": 28.0,
    "asset": "images/02.png",
    "cues": [
      {
        "id": "P004",
        "startTime": "0:15",
        "startSeconds": 15.0,
        "text": "可是，有時候又剛好相反。才靜坐一下子，小貓就昏昏欲睡，提不起精神。",
        "endSeconds": 24.0,
        "quoteIds": []
      },
      {
        "id": "P005",
        "startTime": "0:24",
        "startSeconds": 24.0,
        "text": "原來，心有時太浮動，有時又太沉滯。",
        "endSeconds": 28.0,
        "quoteIds": []
      }
    ],
    "scriptureCues": [],
    "artOverlay": [],
    "originalOverlaySpecification": "無"
  },
  {
    "id": "S03",
    "title": "五蓋",
    "startSeconds": 28.0,
    "endSeconds": 43.0,
    "asset": "images/03.png",
    "cues": [
      {
        "id": "P006",
        "startTime": "0:28",
        "startSeconds": 28.0,
        "text": "在修行的路上，心常常會被各種障礙打擾。佛法把這些障礙，叫做「五蓋」。",
        "endSeconds": 36.0,
        "quoteIds": [
          "Q01"
        ]
      },
      {
        "id": "P007",
        "startTime": "0:36",
        "startSeconds": 36.0,
        "text": "不過，小貓眼前最常遇到的，還是兩種狀況：心太浮動，和心太沉滯。",
        "endSeconds": 43.0,
        "quoteIds": [
          "Q01"
        ]
      }
    ],
    "scriptureCues": [
      {
        "startSeconds": 28.0,
        "quoteId": "Q01"
      }
    ],
