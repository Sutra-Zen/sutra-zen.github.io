{
  "Q01": {
    "quoteId": "Q01",
    "source": "《雜阿含經》第713經",
    "sourceId": "sa713",
    "text": "是名五蓋說十。",
    "type": "video_handoff_transcription"
  },
  "Q02": {
    "quoteId": "Q02",
    "source": "《雜阿含經》第713經",
    "sourceId": "sa713",
    "text": "是名七覺分說為十四。",
    "type": "video_handoff_transcription"
  },
  "Q03": {
    "quoteId": "Q03",
    "source": "《雜阿含經》第715經",
    "sourceId": "sa715",
    "text": "何等為念覺分食？謂四念處思惟已",
    "type": "video_handoff_transcription"
  },
  "Q04": {
    "quoteId": "Q04",
    "source": "《雜阿含經》第713經",
    "sourceId": "sa713",
    "text": "有內法心念住、有外法心念住；彼內法念住即是念覺分，是智是等覺，能轉趣涅槃；彼外法念住即是念覺分，是智是等覺，能轉趣涅槃。",
    "type": "video_handoff_transcription"
  },
  "Q05": {
    "quoteId": "Q05",
    "source": "《雜阿含經》第713經",
    "sourceId": "sa713",
    "text": "有擇善法、擇不善法。彼善法擇，即是擇法覺分，是智是等覺，能轉趣涅槃。彼不善法擇，即是擇法覺分，是智是等覺，能轉趣涅槃。",
    "type": "video_handoff_transcription"
  },
  "Q06": {
    "quoteId": "Q06",
    "source": "《雜阿含經》第713經",
    "sourceId": "sa713",
    "text": "有精進斷不善法，有精進長養善法。彼斷不善法精進，即是精進覺分，是智是等覺，能轉趣涅槃。彼長養善法精進，即是精進覺分，是智是等覺，能轉趣涅槃。",
    "type": "video_handoff_transcription"
  },
  "Q07": {
    "quoteId": "Q07",
    "source": "《雜阿含經》第715經",
    "sourceId": "sa715",
    "text": "何等為精進覺分食？彼四正斷思惟，",
    "type": "video_handoff_transcription"
  },
  "Q08": {
    "quoteId": "Q08",
    "source": "《雜阿含經》第713經",
    "sourceId": "sa713",
    "text": "有喜，有喜處。彼喜即是喜覺分，是智是等覺，能轉趣涅槃。彼喜處，亦即是喜覺分，是智是等覺，能轉趣涅槃。",
    "type": "video_handoff_transcription"
  },
  "Q09": {
    "quoteId": "Q09",
    "source": "《雜阿含經》第713經",
    "sourceId": "sa713",
    "text": "有身猗息，有心猗息。彼身猗息，即是猗覺分，是智是等覺，能轉趣涅槃。彼心猗息，即是猗覺分，是智是等覺，能轉趣涅槃。",
    "type": "video_handoff_transcription"
  },
  "Q10": {
    "quoteId": "Q10",
    "source": "《雜阿含經》第713經",
    "sourceId": "sa713",
    "text": "有定，有定相。彼定即是定覺分，是智是等覺，能轉趣涅槃。彼定相即是定覺分，是智是等覺，能轉趣涅槃。",
    "type": "video_handoff_transcription"
  },
  "Q11": {
    "quoteId": "Q11",
    "source": "《雜阿含經》第810經",
    "sourceId": "sa810",
    "text": "貪憂則滅，得平等捨",
    "type": "video_handoff_transcription"
  },
  "Q12": {
    "quoteId": "Q12",
    "source": "《雜阿含經》第713經",
    "sourceId": "sa713",
    "text": "有捨善法，有捨不善法。彼善法捨，即是捨覺分，是智是等覺，能轉趣涅槃。彼不善法捨，即是捨覺分，是智是等覺，能轉趣涅槃。",
    "type": "video_handoff_transcription"
  },
  "Q13": {
    "quoteId": "Q13",
    "source": "《雜阿含經》第714經",
    "sourceId": "sa714",
    "text": "若微劣心生、微劣猶豫，是時應修擇法覺分、精進覺分、喜覺分。所以者何？微劣心生、微劣猶豫，以此諸法示、教、照、喜。譬如小火，欲令其燃，足其乾薪。",
    "type": "video_handoff_transcription"
  },
  "Q14": {
    "quoteId": "Q14",
    "source": "《雜阿含經》第714經",
    "sourceId": "sa714",
    "text": "若掉心生、掉心猶豫，修猗覺分、定覺分、捨覺分。所以者何？掉心生、掉心猶豫，此等諸法能令內住一心攝持。譬如燃火，欲令其滅，足其燋炭，彼火則滅。",
    "type": "video_handoff_transcription"
  },
  "Q15": {
    "quoteId": "Q15",
    "source": "《雜阿含經》第714經",
    "sourceId": "sa714",
    "text": "念覺分者，一切兼助。",
    "type": "video_handoff_transcription"
  },
  "Q16": {
    "quoteId": "Q16",
    "source": "《中部》第10經〈念住經〉",
    "sourceId": "mn10",
    "text": "有念覺支時，了知有念覺支；沒有時，了知沒有。了知未生起的覺支如何生起，以及已生起的覺支如何修習圓滿。",
    "type": "video_handoff_transcription"
  }
}
